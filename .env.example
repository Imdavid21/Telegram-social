# Railway persistent backend
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
SESSION_SECRET=replace-with-at-least-32-random-characters
BACKEND_PROXY_SECRET=replace-with-another-32-plus-random-characters
NODE_ENV=production

# Optional backend CSRF hardening. Set after the Vercel production URL is known.
PUBLIC_APP_ORIGIN=https://your-app.vercel.app

# Vercel API gateway
TELEGRAM_BACKEND_URL=https://your-service.up.railway.app
# BACKEND_PROXY_SECRET must be identical on Vercel and Railway.

# Local development only
PORT=8787
