{
  "name": "supergram",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "copy:audit": "node scripts/copy-audit.mjs",
    "observer:audit": "node scripts/observer-audit.mjs",
    "build": "npm run copy:audit && npm run observer:audit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "vercel-build": "npm run copy:audit && npm run observer:audit && vite build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "teleproto": "^1.228.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.3"
  }
}
