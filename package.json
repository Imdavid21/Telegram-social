{
  "name": "supergram",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "copy:audit": "node scripts/copy-audit.mjs",
    "observer:audit": "node scripts/observer-audit.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "npm run copy:audit && npm run observer:audit && npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "vercel-build": "npm run copy:audit && npm run observer:audit && npm run typecheck && vite build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "teleproto": "^1.228.5",
    "@reduxjs/toolkit": "^2.9.0",
    "react-redux": "^9.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-slot": "^1.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.3",
    "tailwindcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.15.0"
  }
}
